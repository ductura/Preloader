# nginx site of the optional Render image (deploy/render/Dockerfile). The
# image's entrypoint fills ${PORT}, ${APLICATION_FRONT_URL},
# ${INSTITUTION_SERVER_URL} and ${INSTITUTION_FRONT_URL} from the environment
# at start; nginx's own $variables stay as they are. Routes as in vercel.json
# and the local edge (deploy/edge/dev-proxy.mjs): paths compared literally.
include /etc/nginx/conf.d/csp-map.inc;

server {
    listen ${PORT};
    server_tokens off;
    root /usr/share/nginx/html;

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location = /admin { proxy_pass ${APLICATION_FRONT_URL}; }
    location /admin/ { proxy_pass ${APLICATION_FRONT_URL}; }
    location /api/v1/ { proxy_pass ${INSTITUTION_SERVER_URL}; }
    location = /app/web { proxy_pass ${INSTITUTION_FRONT_URL}; }
    location /app/web/ { proxy_pass ${INSTITUTION_FRONT_URL}; }
    location = /app/chrome { proxy_pass ${INSTITUTION_FRONT_URL}; }
    location /app/chrome/ { proxy_pass ${INSTITUTION_FRONT_URL}; }

    error_page 404 /greska.html;
    location / {
        add_header Content-Security-Policy $ductura_csp always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location = / {
        add_header Content-Security-Policy $ductura_csp always;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }
}
