{
  "name": "@ductura/preloader",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura ulaz: prepoznaje uređaj i preglednik, otvara odgovarajuće sučelje i nudi desktop paket",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "budget": "node scripts/budget.ts dist budget.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
