{
  "name": "@ductura/preloader",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura ulaz: prepoznaje uređaj i preglednik, otvara odgovarajuće sučelje i nudi desktop paket",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "budget": "node scripts/budget.ts dist budget.json",
    "e2e": "node scripts/build.ts && playwright test -c e2e/matrix/playwright.config.ts",
    "edge": "node deploy/edge/dev-proxy.mjs",
    "sve": "node scripts/sve-lokalno.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ductura/contracts": "https://github.com/ductura/server/releases/download/contracts-v2.6.0/ductura-contracts-2.6.0.tgz",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  }
}
