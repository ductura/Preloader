{
  "name": "@ductura/preloader",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura ulaz: prepoznaje uređaj i preglednik, otvara odgovarajuće sučelje i nudi desktop paket",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit -p src/components/landing/tsconfig.preloader.json && tsc --noEmit -p tsconfig.next.json",
    "test": "vitest run --config src/components/landing/vitest.config.ts",
    "build": "next build",
    "budget": "node scripts/budget.ts .next budget.json",
    "e2e": "next build && playwright test -c e2e/matrix/playwright.config.ts && playwright test -c e2e/vs2/playwright.ci.config.ts",
    "e2e:vs2": "playwright test -c e2e/vs2/playwright.config.ts",
    "edge": "node deploy/edge/dev-proxy.mjs",
    "sve": "node scripts/sve-lokalno/main.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ductura/contracts": "https://github.com/ductura/Institution_server/releases/download/contracts-v2.6.0/ductura-contracts-2.6.0.tgz",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "fast-check": "4.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-heading": "3.33.0",
    "@tiptap/extension-history": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
